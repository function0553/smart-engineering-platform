{
  "name": "smart-office-platform",
  "private": true,
  "version": "0.6.0-rc.39",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
