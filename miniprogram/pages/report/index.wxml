<view class="screen">
  <view class="heading"><view><view class="title">施工日报</view></view><button class="account" bindtap="logout">{{user.name || user.username}} · 退出</button></view>
  <button class="secondary" bindtap="history" disabled="{{loading || busy || uploading}}">{{user.role === 'admin' ? '全部汇报记录' : '我的汇报记录'}}</button>
  <button class="link" bindtap="archives" disabled="{{loading || busy || uploading}}">施工影像资料 · 原图与汇总 Word</button>
  <view wx:if="{{loading}}" class="loading">正在载入日报模板…</view>
  <block wx:else>
    <view wx:if="{{user.role === 'viewer'}}" class="error">当前账号为只读，请使用业务操作员或管理员账号填报。</view>
    <view wx:if="{{errors.length}}" class="error"><view class="error-title">请检查填写内容</view><button wx:for="{{errors}}" wx:key="index" class="error-link" data-path="{{item.path}}" bindtap="locateError">{{item.message}}</button></view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <button wx:if="{{submittedId}}" class="link" bindtap="submitted">查看已提交的汇报</button>
    <view wx:if="{{draftWarning}}" class="notice">{{draftWarning}}<button class="link" bindtap="exportData" disabled="{{busy || uploading || loading}}">下载填写数据</button></view>
    <view class="steps"><button class="{{step === 0 ? 'active' : ''}}" data-index="0" bindtap="changeStep">01 日报信息</button><button class="{{step === 1 ? 'active' : ''}}" data-index="1" bindtap="changeStep">02 施工片区</button><button class="{{step === 2 ? 'active' : ''}}" data-index="2" bindtap="changeStep">03 计划与照片</button></view>
    <view wx:if="{{step === 0}}" class="sheet">
      <view class="section-title">日报信息</view>
      <view class="field"><text class="label">工程名称</text><input value="{{base.projectName}}" data-scope="base" data-key="projectName" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">所属区域</text><input value="{{base.region}}" data-scope="base" data-key="region" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">施工日期</text><picker mode="date" value="{{base.reportDate}}" bindchange="changeDate" disabled="{{busy || user.role === 'viewer'}}"><view class="picker-value">{{base.reportDate}} <text>选择日期</text></view></picker></view>
      <view class="field"><text class="label">天气</text><input value="{{base.weather}}" placeholder="自动获取后可按现场情况修正" data-scope="base" data-key="weather" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="weather"><view class="weather-controls"><view>自动获取天气 <switch checked="{{base.weatherAuto}}" color="#2563eb" bindchange="weatherToggle" disabled="{{busy || user.role === 'viewer'}}" /></view><button class="link" bindtap="fetchWeather" disabled="{{weatherLoading || busy || user.role === 'viewer'}}">刷新天气</button></view>
        <view class="help" wx:if="{{weatherLoading}}">正在获取 {{base.reportDate}} 的天气…</view><view class="weather-error" wx:elif="{{weatherError}}">{{weatherError}}</view><view class="help" wx:else>{{weatherDescription}}</view>
        <button class="link location-link" bindtap="toggleLocation">{{base.weatherLocation.name}} · {{locationExpanded ? '收起位置' : '调整天气位置'}}</button>
        <view wx:if="{{locationExpanded}}"><view class="field"><text class="label">位置名称</text><input value="{{base.weatherLocation.name}}" data-scope="location" data-key="name" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view><view class="two-columns"><view class="field"><text class="label">纬度（-90～90）</text><input value="{{base.weatherLocation.latitude}}" data-scope="location" data-key="latitude" bindinput="input" bindblur="locationBlur" disabled="{{busy || user.role === 'viewer'}}" /></view><view class="field"><text class="label">经度（-180～180）</text><input value="{{base.weatherLocation.longitude}}" data-scope="location" data-key="longitude" bindinput="input" bindblur="locationBlur" disabled="{{busy || user.role === 'viewer'}}" /></view></view><view class="help">默认使用经开区参考点，换工程时请调整为施工场地坐标。</view></view>
      </view>
      <view class="field"><text class="label">日报编号（可留空）</text><input value="{{base.number}}" data-scope="base" data-key="number" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view>
    </view>
    <view wx:if="{{step === 1}}" class="sheet">
      <view class="section-title">施工片区</view><picker range="{{sections}}" range-key="name" value="{{selected}}" bindchange="selectSection"><view class="picker-value">{{selected + 1}} / {{sections.length}} · {{current.name}} <text>切换</text></view></picker>
      <view class="section-actions"><button class="link" bindtap="addSection" disabled="{{busy || user.role === 'viewer' || sections.length >= 12}}">＋ 添加片区</button><button class="link danger" bindtap="removeSection" disabled="{{busy || user.role === 'viewer' || sections.length === 1}}">删除当前片区</button></view>
      <view class="field"><text class="label">片区名称</text><input value="{{current.name}}" data-scope="section" data-key="name" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">施工类型</text><picker range="{{kindOptions}}" value="{{current.kind === 'meter' ? 1 : 0}}" bindchange="changeKind" disabled="{{busy || user.role === 'viewer'}}"><view class="picker-value">{{current.kind === 'meter' ? '水表更换 · 完成数量' : '管网施工 · 完成比例'}} <text>选择</text></view></picker></view>
      <view class="field"><text class="label">设计工程量（{{current.kind === 'meter' ? '块' : '米'}}）</text><input type="digit" value="{{current.designQuantity}}" data-scope="section" data-key="designQuantity" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="two-columns"><view class="field"><text class="label">今日完成（{{current.kind === 'meter' ? '块' : '%'}}）</text><input type="digit" value="{{current.todayProgress}}" data-scope="section" data-key="todayProgress" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view><view class="field"><text class="label">累计完成（{{current.kind === 'meter' ? '块' : '%'}}）</text><input type="digit" value="{{current.cumulativeProgress}}" data-scope="section" data-key="cumulativeProgress" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /></view></view><view class="help">完成占比按项目口径填写，不将不同工序工程量相加。</view>
      <view class="subheading">今日完成工作</view><view class="help">空数量不写入日报，0 会保留。</view>
      <view class="work" wx:for="{{current.works}}" wx:key="index"><input class="work-name" value="{{item.name}}" data-scope="work" data-key="name" data-index="{{index}}" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /><view class="work-values"><input type="digit" placeholder="数量" value="{{item.quantity}}" data-scope="work" data-key="quantity" data-index="{{index}}" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /><input class="unit" placeholder="单位" value="{{item.unit}}" data-scope="work" data-key="unit" data-index="{{index}}" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /><button class="remove" data-index="{{index}}" bindtap="removeWork" disabled="{{busy || user.role === 'viewer'}}">删除</button></view></view>
      <button class="link" bindtap="addWork" disabled="{{busy || user.role === 'viewer' || current.works.length >= 40}}">＋ 添加工序</button>
      <view class="field"><text class="label">施工情况补充 / 停工说明</text><textarea value="{{current.todayNotes}}" placeholder="未填写工序数量时，请说明当天情况。每行一个条目。" data-scope="section" data-key="todayNotes" bindinput="input" maxlength="2000" auto-height disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">机械设备</text><textarea value="{{current.machinery}}" placeholder="例如：挖机2台" data-scope="section" data-key="machinery" bindinput="input" maxlength="1000" auto-height disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">施工作业人员（人）</text><input type="number" value="{{current.workers}}" placeholder="未核实可留空" data-scope="section" data-key="workers" bindinput="input" maxlength="7" disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">交通安保人员（人 / 情况）</text><input value="{{current.security}}" data-scope="section" data-key="security" bindinput="input" maxlength="100" disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">本片区明日计划</text><textarea value="{{current.tomorrow}}" data-scope="section" data-key="tomorrow" bindinput="input" maxlength="2000" auto-height disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">手续办理 / 协调事项</text><textarea value="{{current.procedures}}" data-scope="section" data-key="procedures" bindinput="input" maxlength="2000" auto-height disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="field"><text class="label">施工困难与需协调问题</text><textarea value="{{current.difficulties}}" data-scope="section" data-key="difficulties" bindinput="input" maxlength="2000" auto-height disabled="{{busy || user.role === 'viewer'}}" /></view>
    </view>
    <view wx:if="{{step === 2}}" class="sheet">
      <view class="section-title">计划与现场照片</view><view class="field"><text class="label">明日总体施工计划</text><textarea value="{{base.nextPlan}}" data-scope="base" data-key="nextPlan" bindinput="input" maxlength="4000" auto-height disabled="{{busy || user.role === 'viewer'}}" /></view><view class="field"><text class="label">其他事项</text><textarea value="{{base.otherItems}}" data-scope="base" data-key="otherItems" bindinput="input" maxlength="4000" auto-height disabled="{{busy || user.role === 'viewer'}}" /></view>
      <view class="subheading">现场照片（{{photos.length}} / 12）</view><view class="help">支持 PNG/JPEG，单张不超过5MB，合计不超过20MB。照片按选择顺序写入日报。</view>
      <view class="photo" wx:for="{{photos}}" wx:key="index"><image src="{{item.path}}" mode="widthFix" /><view class="photo-caption"><input placeholder="照片说明" value="{{item.caption}}" data-scope="photo" data-key="caption" data-index="{{index}}" bindinput="input" disabled="{{busy || user.role === 'viewer'}}" /><button class="remove" data-index="{{index}}" bindtap="removePhoto" disabled="{{busy || user.role === 'viewer'}}">删除</button></view></view>
      <button class="secondary" bindtap="addPhotos" disabled="{{uploading || busy || user.role === 'viewer' || photos.length >= 12}}">{{uploading ? '正在读取照片…' : '拍照 / 选择现场照片'}}</button>
      <view class="data-tools"><button class="link" bindtap="importData" disabled="{{busy || uploading || user.role === 'viewer'}}">导入填写数据</button><button class="link" bindtap="exportData" disabled="{{busy || uploading}}">导出填写数据</button></view>
    </view>
    <view class="draft help">{{draftNotice}}</view>
    <view wx:if="{{savedFile}}" class="file-actions"><button class="secondary" bindtap="openWord">查看 Word</button><button class="primary" bindtap="shareWord">转发文件</button></view>
    <view class="bottom"><button wx:if="{{step !== 2}}" class="secondary" data-index="{{step + 1}}" bindtap="changeStep">下一项</button><button class="primary generate" bindtap="generate" disabled="{{busy || uploading || weatherLoading || user.role === 'viewer'}}">{{busy ? '正在提交…' : '提交并生成 Word'}}</button></view>
  </block>
</view>
