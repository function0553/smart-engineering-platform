<view class="screen">
  <view class="heading"><view class="title">{{detail ? '汇报详情' : user.role === 'admin' ? '全部汇报记录' : '我的汇报记录'}}</view><button wx:if="{{detail}}" class="link" bindtap="back">返回记录</button><button wx:else class="link" bindtap="refresh" disabled="{{loading}}">刷新</button></view>
  <view class="help">服务器保存文字、原图和 Word。{{user.role === 'admin' ? '可查看全部填报人的提交。' : '仅显示自己的提交。'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{!detail}}">
    <view class="filters"><view class="field"><text class="label">施工日期</text><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="picker">{{date || '全部日期'}}</view></picker></view><view class="field"><text class="label">工程 / 填报人 / 编号</text><input type="text" value="{{q}}" placeholder="输入关键词" maxlength="100" bindinput="searchInput" bindconfirm="search" /></view><view class="actions"><button class="primary" bindtap="search" disabled="{{loading}}">筛选</button><button class="link" bindtap="clearFilter" disabled="{{loading}}">清除筛选</button></view></view>
    <view wx:if="{{loading}}" class="loading">正在读取汇报记录…</view>
    <view wx:else><view class="count">共 {{total}} 条提交</view><view wx:if="{{!items.length}}" class="empty"><view class="section-title">暂无汇报记录</view><view class="help">填写日报并提交后，可在此查看。已有筛选时可清除筛选。</view></view><view class="record" wx:for="{{items}}" wx:key="id"><button class="record-open" data-id="{{item.id}}" bindtap="open" disabled="{{opening}}"><view class="record-title">{{item.projectName}}</view><view>{{item.reportDate}} · {{item.region}} {{item.number}}</view><view class="help">{{item.authorName}} · {{item.photoCount}} 张照片</view></button><button class="link" data-id="{{item.id}}" bindtap="word" disabled="{{saving}}">下载 Word</button></view><view wx:if="{{total > 20}}" class="pagination"><button class="secondary" bindtap="previous" disabled="{{!offset || loading}}">上一页</button><text>第 {{pageNumber}} 页</text><button class="secondary" bindtap="next" disabled="{{!hasNext || loading}}">下一页</button></view></view>
    <view wx:if="{{opening}}" class="loading">正在打开汇报…</view>
  </view>
  <view wx:else>
    <view class="summary"><view class="section-title">{{detail.projectName}}</view><view>{{detail.reportDate}} · {{detail.region}} · {{detail.data.weather}}</view><view wx:if="{{detail.number}}">编号：{{detail.number}}</view><view class="help">填报人：{{detail.authorName}}<text class="block">提交时间：{{detail.createdAt}}</text></view><view class="actions"><button class="primary" data-id="{{detail.id}}" bindtap="word" disabled="{{saving}}">下载 Word</button><button class="secondary" bindtap="originalData" disabled="{{saving}}">原图与填写数据</button></view></view>
    <view class="section" wx:for="{{detail.data.sections}}" wx:key="index"><view class="section-title">{{item.name}}</view><view class="pair"><text class="label">设计工程量</text><text>{{item.designQuantity}}{{item.kind === 'meter' ? '块' : '米'}}</text></view><view class="pair"><text class="label">今日 / 累计完成</text><text>{{item.todayProgress}} / {{item.cumulativeProgress}}{{item.kind === 'meter' ? '块' : '%'}}</text></view><view class="pair"><text class="label">完成工序</text><text>{{item.workText}}</text></view><view class="pair"><text class="label">施工情况</text><text>{{item.todayNotes || '未填写'}}</text></view><view class="pair"><text class="label">施工机械</text><text>{{item.machinery || '未填写'}}</text></view><view class="pair"><text class="label">作业人员</text><text>{{item.workers === '' ? '未填写' : item.workers + '人'}}</text></view><view class="pair"><text class="label">交通安保人员</text><text>{{item.security || '未填写'}}</text></view><view class="pair"><text class="label">明日计划</text><text>{{item.tomorrow || '未填写'}}</text></view><view class="pair"><text class="label">手续办理</text><text>{{item.procedures || '未填写'}}</text></view><view class="pair"><text class="label">难点及推进</text><text>{{item.difficulties || '未填写'}}</text></view></view>
    <view class="section"><view class="section-title">汇总与现场原图</view><view class="pair"><text class="label">明日施工计划汇总</text><text>{{detail.data.nextPlan}}</text></view><view class="pair"><text class="label">其他事项</text><text>{{detail.data.otherItems || '未填写'}}</text></view><view wx:for="{{photos}}" wx:key="index" class="photo"><image wx:if="{{item.path}}" src="{{item.path}}" mode="widthFix" data-path="{{item.path}}" bindtap="preview" /><view wx:elif="{{item.failed}}" class="error">照片 {{index + 1}} 读取失败，请返回记录后重新打开。</view><view wx:else class="help">正在读取照片 {{index + 1}}…</view><view class="help">图 {{index + 1}} · {{item.caption || item.name}}</view></view><view wx:if="{{!photos.length}}" class="help">本次汇报未提交照片。</view></view>
  </view>
  <button wx:if="{{savedFile}}" class="secondary" bindtap="share">转发已下载的 Word</button>
</view>
