# 252 启动脚本配置模板；此端口由 252 的 HTTPS 反向代理转发。
NODE_BINARY=/opt/smart-engineering/runtime/node-v24.19.0-linux-x64/bin/node
HOST=127.0.0.1
PORT=15186
BASE_URL=https://211.139.12.141:21901
DATABASE_PATH=/opt/smart-engineering/shared/workspace.sqlite
MODELS_PATH=/opt/smart-engineering/shared/models
PPE_CONFIG_FILE=/etc/camera4g/private/ppe-upstream.json
CAMERA4G_ATTENDANCE_CONFIG_FILE=/etc/camera4g/private/attendance-upstream.json
# 私有 CA 时指向可信根证书，禁止 NODE_TLS_REJECT_UNAUTHORIZED=0。
# NODE_EXTRA_CA_CERTS=/etc/camera4g/private/gpu-ca.pem
