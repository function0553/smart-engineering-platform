# GPU 启动脚本私有配置模板，复制到 /etc/camera4g/private/gpu.env 后填写。
GPU_PYTHON=/opt/camera4g/venv/bin/python
# 沿用已有 GPU 运行环境时可指定；新环境应填写自己的 CUDA/cuDNN 动态库位置。
# GPU_CUDA_LIBRARY_PATH_FILE=/data/4g-camera-inference/config/cuda-library-path.txt
VIDEO_CONFIG=/etc/camera4g/private/video.json
PREVIEW_CONFIG=/etc/camera4g/private/preview.json
ATTENDANCE_CONFIG=/etc/camera4g/private/attendance.json
PPE_MAIN_STREAM_ENDPOINT='rtsp://127.0.0.1:12954/camera_main_02?stream=0'
PPE_VIDEO_ADMIN_TOKEN=REPLACE_DISTINCT_ADMIN_TOKEN_AT_LEAST_32_CHARS
PPE_VIDEO_CAMERA_TOKEN=REPLACE_CAMERA_TOKEN_AT_LEAST_32_CHARS
PPE_PREVIEW_PASS=REPLACE_PREVIEW_PASSWORD_AT_LEAST_32_CHARS
PPE_MEDIA_READ_USER=viewer
PPE_MEDIA_READ_PASS=REPLACE_MEDIA_PASSWORD_AT_LEAST_32_CHARS
ATTENDANCE_ADMIN_TOKEN=REPLACE_ATTENDANCE_TOKEN_AT_LEAST_32_CHARS
