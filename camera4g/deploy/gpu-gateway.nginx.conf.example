# GPU HTTPS 网关配置示例，放在 nginx http {} 内；先替换域名、证书和 252 出口 IP。
# 29478/29480/29482 必须映射至 GPU，不能误映射至 252。同机服务端口按实际配置修改。
# 这里的 127.0.0.1 仅供 GPU 网关访问 GPU 本机进程，252 使用上面的 HTTPS 外部入口。
server {
    listen 29478 ssl;
    server_name gpu.example.com;
    ssl_certificate /etc/camera4g/tls/fullchain.pem;
    ssl_certificate_key /etc/camera4g/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 192.168.1.252; # 改为 GPU 实际看到的 252 出口 IP
    deny all;
    location / { proxy_pass http://127.0.0.1:28878; proxy_set_header Authorization $http_authorization; }
}
server {
    listen 29480 ssl;
    server_name gpu.example.com;
    ssl_certificate /etc/camera4g/tls/fullchain.pem;
    ssl_certificate_key /etc/camera4g/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 192.168.1.252;
    deny all;
    location / {
        proxy_pass http://127.0.0.1:28880;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_read_timeout 20s;
    }
}
server {
    listen 29482 ssl;
    server_name gpu.example.com;
    ssl_certificate /etc/camera4g/tls/fullchain.pem;
    ssl_certificate_key /etc/camera4g/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow 192.168.1.252;
    deny all;
    client_max_body_size 8m;
    location /api/ {
        proxy_pass http://127.0.0.1:28982;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 70s;
    }
    location / { return 404; }
}
