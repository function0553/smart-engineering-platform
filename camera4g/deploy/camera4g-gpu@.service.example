[Unit]
Description=4G camera GPU startup script (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=camera4g
Group=camera4g
Environment=CAMERA4G_GPU_ENV=/etc/camera4g/private/gpu.env
ExecStart=/bin/bash /opt/hyc/camera4g/deploy/start-gpu.sh %i
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
